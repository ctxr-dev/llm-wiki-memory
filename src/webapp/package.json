{
  "name": "llm-wiki-webapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"node server/index.mjs\" \"vite\"",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:comments": "test -z \"$(grep -rnE '(^|[^:/])//|^[[:space:]]*/\\*[^*]' server shared client --include='*.ts' --include='*.tsx' --include='*.mjs' | grep -vE '@ts-|eslint-|https?://')\"",
    "gates": "npm run typecheck && npm run lint -- --max-warnings 0 && npm run check:comments && npm run build && npm run test"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.1",
    "@fastify/static": "^8.0.4",
    "@heroicons/react": "^2.2.0",
    "@lexical/code": "^0.21.0",
    "@lexical/headless": "^0.21.0",
    "@lexical/link": "^0.21.0",
    "@lexical/list": "^0.21.0",
    "@lexical/markdown": "^0.21.0",
    "@lexical/react": "^0.21.0",
    "@lexical/rich-text": "^0.21.0",
    "@lexical/utils": "^0.21.0",
    "@tanstack/react-query": "^5.62.7",
    "@tanstack/react-virtual": "^3.14.6",
    "@uiw/react-codemirror": "^4.25.11",
    "diff": "^7.0.0",
    "fastify": "^5.2.0",
    "github-slugger": "^2.0.0",
    "lexical": "^0.21.0",
    "mermaid": "^11.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^1.29.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.61.1",
    "@testing-library/react": "^16.1.0",
    "@types/diff": "^7.0.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
