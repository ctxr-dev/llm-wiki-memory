{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreWorkspaces": ["src/webapp"],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.mjs",
        "scripts/hooks/*.mjs",
        "test/**/*.test.mjs",
        "test/setup-guard.mjs"
      ],
      "project": ["scripts/**/*.mjs", "mcp-server/**/*.mjs"]
    }
  },
  "ignoreBinaries": ["awk", "playwright"]
}
